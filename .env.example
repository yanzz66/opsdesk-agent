
# ======================================
# OpsDesk Agent - Environment Template
# ======================================

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3

# API Authentication
OPSDESK_USER_KEY=replace_with_random_user_key
OPSDESK_APPROVER_KEY=replace_with_random_approver_key

# LangGraph
OPSDESK_CHECKPOINT_BACKEND=sqlite
OPSDESK_TICKET_PLANNER=rule

# SQLite
OPSDESK_DB_PATH=E:/opsdesk-agent/data/tickets.db
OPSDESK_CHECKPOINT_PATH=E:/opsdesk-agent/data/checkpoints.db

# Frontend API
OPSDESK_API_BASE_URL=http://127.0.0.1:8000